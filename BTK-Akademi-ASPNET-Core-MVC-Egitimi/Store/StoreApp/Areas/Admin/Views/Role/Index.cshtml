@model IEnumerable<IdentityRole>



<div class="container">
    
    <div class="text-center my-5 border-bottom justify-content-between">
        <div class="display-6">Roles</div>
        <div class="d-flex justify-content-end my-2">
            <a asp-controller="Role" asp-action="Create" class="btn btn-warning">
                <i class="fa-solid fa-plus"></i>
            </a>
        </div>
    </div>
    <table>
        <thead>
            <tr>
            <td>Name</td>
            <td>NormalizedName</td>
            <td>Settings</td>
            </tr>
        </thead>
        <tbody>
             @foreach (var role in Model)
            {
                <tr>
            <td> 
                 @role.Name
            </td>
            <td>
                @role.NormalizedName
            </td>
            <td>
                        <div class="btn-group rounded-0">
                            <a data-toggle="tooltip" data-placement="top" title="Edit" class="btn btn-warning"
                               asp-action="Update" asp-route-id="@role.Id">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a data-toggle="tooltip" data-placement="top" title="Delete" class="btn btn-danger"
                               asp-action="Delete" asp-route-id="@role.Id">
                                <i class="fa fa-trash"></i>
                            </a>
                        </div>
            </td>
                </tr>
             }
        </tbody>
    </table>
    

</div>


@section Scripts
                            {
    <script type="text/javascript">
        $(document).ready(() => {
            $('[data-toggle="tooltip"]').tooltip()
        });
    </script>
}