@model CustomerViewModel.CustomerDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Customer.FullName} - Müşteri Detayı";
}

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>Müşteri Bilgileri</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <td><strong>Ad Soyad:</strong></td>
                            <td>@Model.Customer.FullName</td>
                        </tr>
                        <tr>
                            <td><strong>Email:</strong></td>
                            <td>@Model.Customer.Email</td>
                        </tr>
                        <tr>
                            <td><strong>Kayıt Tarihi:</strong></td>
                            <td>@Model.Customer.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td><strong>Durum:</strong></td>
                            <td>
                                <span class="badge @(Model.Customer.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.Customer.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Customer.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i>Düzenle
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-list me-1"></i>Müşteri Listesi
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-shopping-bag me-2"></i>Son Siparişler</h5>
                <a asp-controller="Order" asp-action="Create" asp-route-customerId="@Model.Customer.Id"
                class="btn btn-sm btn-primary">
                    <i class="fas fa-plus me-1"></i>Yeni Sipariş
                </a>
            </div>
            <div class="card-body">
                @if (Model.RecentOrders.Any())
                {
                    <partial name="_OrderListPartial" model="@Model.RecentOrders" />
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-shopping-bag fa-2x text-muted mb-3"></i>
                        <p class="text-muted">Henüz sipariş bulunmuyor.</p>
                        <a asp-controller="Order" asp-action="Create" asp-route-customerId="@Model.Customer.Id"
                        class="btn btn-primary btn-sm">
                            <i class="fas fa-plus me-1"></i>İlk Siparişi Oluştur
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<partial name="_ModalPartial" model="@Model.RecentOrders"/>