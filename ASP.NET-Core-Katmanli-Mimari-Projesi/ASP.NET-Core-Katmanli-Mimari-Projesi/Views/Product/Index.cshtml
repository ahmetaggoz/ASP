@model ProductViewModel.ProductListViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Ürünler (@Model.Products.Count())</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Yeni Ürün
    </a>
</div>

@if (Model.Products.Any())
{
    @foreach (var product in Model.Products)
    {
        <div class="container">
            <div class="col-md-3"></div>
            <div class="col-md-9">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">
                            <h6>@product.Name</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="lead">@product.Description</p>
                        <p class="lead">Stok: @product.Stock</p>
                    </div>
                    <div class="card-footer">
                        <p class="lead">Fiyat: @product.Price</p>
                    </div>
                </div>
            </div>
        </div>
                
    }
}
else
{
    <p>Henüz ürün yok</p>
}
